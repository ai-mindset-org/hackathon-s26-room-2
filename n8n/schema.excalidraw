      "roundness": null,
      "seed": 579885361,
      "versionNonce": 348703820,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756468800000,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 2,
      "text": "ПОЧЕМУ ОБЫЧНОЙ НОДОЙ, А НЕ ИНСТРУМЕНТОМ АГЕНТА\n\ntoolWorkflow агент вызывает ПО СВОЕМУ РЕШЕНИЮ —\nможет и не позвать. Тогда гард наследует ровно ту\nпроблему, ради которой создан. Здесь он вшит\nв цепочку: модель не может его обойти.",
      "originalText": "ПОЧЕМУ ОБЫЧНОЙ НОДОЙ, А НЕ ИНСТРУМЕНТОМ АГЕНТА\n\ntoolWorkflow агент вызывает ПО СВОЕМУ РЕШЕНИЮ —\nможет и не позвать. Тогда гард наследует ровно ту\nпроблему, ради которой создан. Здесь он вшит\nв цепочку: модель не может его обойти.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "el1034",
