    },
    {
      "id": "el1036",
      "type": "text",
      "x": 1180,
      "y": 300,
      "width": 470,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 985945654,
      "versionNonce": 799384489,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756468800000,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 2,
      "text": "ЧТО ПРОВЕРЯЕТ ГАРД (детерминированно, без модели)\n\nВыдумка\n  каждое число — буквально из базы, из запроса\n  клиента или выводится арифметикой по прайсу:\n    406 800  <-  12 × 33 900 (TS-192E)\n    378 324  <-  12 × 33 900 (TS-192E) − 7%\n    485 266  <-  сумма строк\n  артикулы, email, ссылки, телефоны\n\nРегламент\n  «вы», обращение по имени, подпись,\n  цена только с артикулом, запрет «завтра»\n  и безусловных обещаний, честное «в базе нет»\n  + передача менеджеру\n\nПрайс и сделка\n  скидка 7% только от 10 шт одной позиции;\n  товар вне позиций сделки, расхождение итога,\n  валюта, контакт, стадия сделки",
      "originalText": "ЧТО ПРОВЕРЯЕТ ГАРД (детерминированно, без модели)\n\nВыдумка\n  каждое число — буквально из базы, из запроса\n  клиента или выводится арифметикой по прайсу:\n    406 800  <-  12 × 33 900 (TS-192E)\n    378 324  <-  12 × 33 900 (TS-192E) − 7%\n    485 266  <-  сумма строк\n  артикулы, email, ссылки, телефоны\n\nРегламент\n  «вы», обращение по имени, подпись,\n  цена только с артикулом, запрет «завтра»\n  и безусловных обещаний, честное «в базе нет»\n  + передача менеджеру\n\nПрайс и сделка\n  скидка 7% только от 10 шт одной позиции;\n  товар вне позиций сделки, расхождение итога,\n  валюта, контакт, стадия сделки",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "lineHeight": 1.25
    },
